{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.motora.dirshay.com/api",
        "EXPO_PUBLIC_UPLOAD_URL": "https://api.motora.dirshay.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.motora.dirshay.com/api",
        "EXPO_PUBLIC_UPLOAD_URL": "https://api.motora.dirshay.com"
      }
    }
  }
}
