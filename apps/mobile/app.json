{
  "expo": {
    "name": "DriveET",
    "slug": "driveet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "driveet",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "et.driveet.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111111"
      },
      "package": "et.driveet.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "DriveET",
      "shortName": "DriveET",
      "description": "Buy and sell cars in Ethiopia",
      "themeColor": "#111111",
      "backgroundColor": "#F7F8F7",
      "display": "standalone",
      "lang": "en",
      "startUrl": "/"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
