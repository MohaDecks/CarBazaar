NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/car-marketplace
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_IMAGES_PER_VEHICLE=20
# Active media storage: cloudinary | local | s3
# s3 is a future stub — do not select it until S3StorageProvider is implemented.
# AWS is optional and not required to run the API.
STORAGE_PROVIDER=cloudinary

# Cloudinary (backend only — never put these in web/mobile/admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Future S3 (unused — do not set STORAGE_PROVIDER=s3 yet)
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Firebase Admin (Cloud Messaging — server push)
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
