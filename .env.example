# Copy to apps/api/.env and adjust as needed
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/car-marketplace
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3232
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
