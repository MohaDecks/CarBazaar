NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/car-marketplace
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
CORS_ORIGIN=https://sell.motora.dirshay.com,https://admin.motora.dirshay.com
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_IMAGES_PER_VEHICLE=20
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
